# Firmware Updater — environment configuration
#
# Copy this file to .env (for local dev) and adjust as needed.
# See README.md "Safety status" section before changing VITE_ENABLE_REAL_FLASHING.

# Master safety switch for sending real firmware-update commands to hardware
# over Web Serial. Must remain "false" until the protocol has been validated
# against a physical device (see docs/gtool-analysis for open items).
#
# In this phase, the Web Serial transport does not implement firmware
# transmission at all (see src/lib/webserial), so real flashing is disabled
# in two independent places. This flag is the single documented switch a
# future phase will flip once hardware validation is complete.
VITE_ENABLE_REAL_FLASHING=false
